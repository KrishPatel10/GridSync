{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GridSync": {
    "Rows": 100000,
    "Cols": 26,
    "MaxSheets": 1000,
    "MaxValueLength": 10000,
    "MaxOpsPerBatch": 500,
    "MaxClockSkewSeconds": 60,
    "SnapshotEveryNOps": 200,
    "SnapshotCheckIntervalSeconds": 10
  },
  "ConnectionStrings": {
    // No default on purpose: without one, the server falls back to an in-memory store (same
    // behaviour as phase 1, state lost on restart) instead of failing to start. Set this to use
    // real persistence; docker-compose.yml starts a matching SQL Server locally.
    "GridSync": ""
  }
}
