    { "name": "round 49 to hundreds", "formula": "=ROUND(49,-2)", "expected": { "type": "number", "value": 0 } },
    { "name": "round 50 to hundreds", "formula": "=ROUND(50,-2)", "expected": { "type": "number", "value": 100 } },
    { "name": "round carries into a new digit", "formula": "=ROUND(999.999,2)", "expected": { "type": "number", "value": 1000 } },
    { "name": "round cleans floating point noise", "formula": "=ROUND(0.1+0.2,1)=0.3", "expected": { "type": "boolean", "value": true } },
    { "name": "round with plenty of places changes nothing", "formula": "=ROUND(5,400)", "expected": { "type": "number", "value": 5 } },
    { "name": "round truncates the digit count", "formula": "=ROUND(2.567,1.9)", "expected": { "type": "number", "value": 2.6 } },
    { "name": "round of an average", "cells": { "A1": "1", "A2": "2", "A3": "4" }, "formula": "=ROUND(SUM(A1:A3)/3,2)", "expected": { "type": "number", "value": 2.33 } },
    { "name": "round with one argument", "formula": "=ROUND(2.5)", "expected": { "type": "error", "value": "#VALUE!" } },
