    { "name": "reference to an empty cell shows zero", "formula": "=A1", "expected": { "type": "number", "value": 0 } },
    { "name": "exponent notation in a cell is a number", "cells": { "A1": "1e2" }, "formula": "=A1", "expected": { "type": "number", "value": 100 } },
    { "name": "explicit plus sign in a cell is a number", "cells": { "A1": "+5" }, "formula": "=A1", "expected": { "type": "number", "value": 5 } },
    { "name": "fraction without leading zero in a cell", "cells": { "A1": "-.5" }, "formula": "=A1", "expected": { "type": "number", "value": -0.5 } },
    { "name": "trailing point in a cell", "cells": { "A1": "5." }, "formula": "=A1", "expected": { "type": "number", "value": 5 } },
    { "name": "a space makes a cell text", "cells": { "A1": " 5" }, "formula": "=A1", "expected": { "type": "text", "value": " 5" } },
    { "name": "thousands separator makes a cell text", "cells": { "A1": "1,000" }, "formula": "=A1", "expected": { "type": "text", "value": "1,000" } },
    { "name": "a number too big for a double stays text", "cells": { "A1": "1e400" }, "formula": "=A1", "expected": { "type": "text", "value": "1e400" } },
    { "name": "TRUE typed in a cell is text, not a boolean", "cells": { "A1": "TRUE" }, "formula": "=A1", "expected": { "type": "text", "value": "TRUE" } },

    { "name": "concatenate text", "formula": "=\"a\"&\"b\"", "expected": { "type": "text", "value": "ab" } },
    { "name": "concatenate numbers", "formula": "=1&2", "expected": { "type": "text", "value": "12" } },
    { "name": "plus binds tighter than concatenate", "formula": "=1&2+3", "expected": { "type": "text", "value": "15" } },
    { "name": "concatenate shows 15 digits", "formula": "=0.1+0.2&\"\"", "expected": { "type": "text", "value": "0.3" } },
    { "name": "concatenate a boolean", "formula": "=TRUE&\"x\"", "expected": { "type": "text", "value": "TRUEx" } },
    { "name": "empty cell concatenates as nothing", "formula": "=A1&\"!\"", "expected": { "type": "text", "value": "!" } },
    { "name": "two empty cells concatenate to empty text", "formula": "=A1&A2", "expected": { "type": "text", "value": "" } },
    { "name": "one third", "formula": "=1/3&\"\"", "expected": { "type": "text", "value": "0.333333333333333" } },
    { "name": "whole number has no decimal point", "formula": "=100&\"\"", "expected": { "type": "text", "value": "100" } },
    { "name": "negative number text", "formula": "=-1.5&\"\"", "expected": { "type": "text", "value": "-1.5" } },
    { "name": "15 digit integer stays plain", "formula": "=123456789012345&\"\"", "expected": { "type": "text", "value": "123456789012345" } },
    { "name": "1e15 switches to scientific", "formula": "=1E15&\"\"", "expected": { "type": "text", "value": "1E+15" } },
    { "name": "2 to the 53 is cut to 15 digits", "formula": "=2^53&\"\"", "expected": { "type": "text", "value": "9.00719925474099E+15" } },
    { "name": "exact tie at the 16th digit rounds up (even digit before it)", "formula": "=1000000000000005&\"\"", "expected": { "type": "text", "value": "1.00000000000001E+15" } },
    { "name": "exact tie at the 16th digit rounds up (other even digit)", "formula": "=1000000000000025&\"\"", "expected": { "type": "text", "value": "1.00000000000003E+15" } },
    { "name": "exact tie rounds away from zero for negatives", "formula": "=-1000000000000005&\"\"", "expected": { "type": "text", "value": "-1.00000000000001E+15" } },
    { "name": "an exact tie can carry into a new digit", "formula": "=999999999999999.5&\"\"", "expected": { "type": "text", "value": "1E+15" } },
    { "name": "a tie feeds ROUND the same way","formula": "=ROUND(1000000000000005,-1)&\"\"", "expected": { "type": "text", "value": "1.00000000000001E+15" } },
    { "name": "float noise below 15 digits disappears", "formula": "=1.005*1000&\"\"", "expected": { "type": "text", "value": "1005" } },
    { "name": "smallest positive double", "formula": "=5E-324&\"\"", "expected": { "type": "text", "value": "4.94065645841247E-324" } },
    { "name": "0.00001 stays plain","formula": "=0.00001&\"\"", "expected": { "type": "text", "value": "0.00001" } },
    { "name": "0.000001 switches to scientific", "formula": "=0.000001&\"\"", "expected": { "type": "text", "value": "1E-06" } },
