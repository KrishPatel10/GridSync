    { "name": "negating text", "cells": { "A1": "x" }, "formula": "=-A1", "expected": { "type": "error", "value": "#VALUE!" } },

    { "name": "number literal", "formula": "=42", "expected": { "type": "number", "value": 42 } },
    { "name": "text literal", "formula": "=\"hello\"", "expected": { "type": "text", "value": "hello" } },
    { "name": "TRUE literal", "formula": "=TRUE", "expected": { "type": "boolean", "value": true } },
    { "name": "FALSE literal", "formula": "=false", "expected": { "type": "boolean", "value": false } },
