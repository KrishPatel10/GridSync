    { "name": "range beyond the last row", "formula": "=SUM(A1:A100001)", "expected": { "type": "error", "value": "#REF!" } },
    { "name": "count of an out-of-sheet range is still #REF!", "formula": "=COUNT(A1:AA1)", "expected": { "type": "error", "value": "#REF!" } },

