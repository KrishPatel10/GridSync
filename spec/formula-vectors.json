    { "name": "unknown function", "formula": "=FOO(1)", "expected": { "type": "error", "value": "#NAME?" } },
    { "name": "unknown function whose name looks like a cell", "formula": "=LOG10(1)", "expected": { "type": "error", "value": "#NAME?" } },
    { "name": "unknown function does not evaluate its arguments", "formula": "=FOO(1/0)", "expected": { "type": "error", "value": "#NAME?" } },
    { "name": "unknown name", "formula": "=TAX", "expected": { "type": "error", "value": "#NAME?" } },
    { "name": "function names are case insensitive", "formula": "=sum(1,2)", "expected": { "type": "number", "value": 3 } },

    { "name": "cell beyond the last column", "formula": "=AA1", "expected": { "type": "error", "value": "#REF!" } },
    { "name": "last row is valid", "formula": "=Z100000", "expected": { "type": "number", "value": 0 } },
    { "name": "cell beyond the last row", "formula": "=Z100001", "expected": { "type": "error", "value": "#REF!" } },
